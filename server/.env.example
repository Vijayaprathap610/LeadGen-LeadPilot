PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<db_user>:<db_password>@leadpilot.rwantnw.mongodb.net/
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=5
MAX_IMPORT_ROWS=20000

# Scoring (optional). Medium threshold must be lower than high.
SCORE_HIGH_THRESHOLD=70
SCORE_MEDIUM_THRESHOLD=40
# Comma-separated industry keywords that count as relevant; leave empty to skip industry scoring
TARGET_INDUSTRIES=

# Rate limits per 15 minutes per IP
RATE_LIMIT_MAX=300
IMPORT_RATE_LIMIT_MAX=20
# Set to true when deployed behind one proxy (Render, Heroku, etc.)
TRUST_PROXY=false
